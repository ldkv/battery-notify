{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "bootstrap-sha": "8a53a6aca4e2deca96b38e2b1f497b1603e805f5",
  "skip-changelog": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "✨ Features"
    },
    {
      "type": "fix",
      "section": "🐛 Bug Fixes"
    },
    {
      "type": "perf",
      "section": "⚡ Performance"
    },
    {
      "type": "refactor",
      "section": "♻️ Refactoring"
    },
    {
      "type": "docs",
      "section": "📝 Documentation"
    },
    {
      "type": "chore",
      "section": "🧹 Chores"
    },
    {
      "type": "test",
      "section": "✅ Tests",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "rust",
      "include-component-in-tag": false,
      "pull-request-title-pattern": "chore: release ${version}"
    }
  }
}
